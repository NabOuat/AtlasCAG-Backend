DJANGO_SETTINGS_MODULE=config.settings.dev

SECRET_KEY=remplacer-par-une-vraie-cle-secrete-longue

# ── Base principale AtlasCore ─────────────────────────────────────────────────
# Créer manuellement dans psql : CREATE DATABASE AtlasCore;
# Puis lancer : python manage.py migrate
DB_NAME=AtlasCore
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Bases spatiales OVH (données QGIS — lecture seule) ───────────────────────
# Ces bases sont sur le serveur OVH. Ne pas les recréer, renseigner les accès.
GEO_HOST=ip-du-serveur-ovh
GEO_PORT=5432

GEO_CAVALLY_DB=nom_db_cavally
GEO_CAVALLY_USER=user_cavally
GEO_CAVALLY_PASSWORD=password_cavally

GEO_WORODOUGOU_DB=nom_db_worodougou
GEO_WORODOUGOU_USER=user_worodougou
GEO_WORODOUGOU_PASSWORD=password_worodougou

